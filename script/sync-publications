#!/usr/bin/env python3
"""Extract structured publication data from the CV (standard library only)."""

import argparse
import html
import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def render_tex(source):
    """Convert the supported CV inline markup; reject unsupported LaTeX."""
    def group(position):
        if position >= len(source) or source[position] != '{':
            raise ValueError('Expected a braced LaTeX argument')
        depth = 1
        end = position + 1
        while end < len(source) and depth:
            if source[end] == '{':
                depth += 1
            elif source[end] == '}':
                depth -= 1
            end += 1
        if depth:
            raise ValueError('Unclosed LaTeX argument')
        return source[position + 1:end - 1], end

    result = []
    position = 0
    while position < len(source):
        if source[position] != '\\':
            end = source.find('\\', position)
            if end == -1:
                end = len(source)
            plain = source[position:end]
            if '{' in plain or '}' in plain:
                raise ValueError('Unsupported bare LaTeX braces')
            plain = plain.replace('``', '“').replace("''", '”')
            plain = plain.replace('---', '—').replace('--', '–').replace('~', ' ')
            result.append(html.escape(plain))
            position = end
            continue
        match = re.match(r'\\(textbf|emph|doi|pdf|ssrn|href)\b', source[position:])
        if not match:
            raise ValueError(f'Unsupported LaTeX near {source[position:position + 40]!r}')
        command = match[1]
        argument, position = group(position + len(match[0]))
        if command in ('textbf', 'emph'):
            tag = 'strong' if command == 'textbf' else 'em'
            result.append(f'<{tag}>{render_tex(argument)}</{tag}>')
        else:
            prefixes = {'doi': 'https://doi.org/', 'ssrn': 'https://ssrn.com/abstract='}
            url = prefixes.get(command, '') + argument
            if not url.startswith(('https://', 'http://')):
                raise ValueError(f'Unsupported link: {url}')
            label = f'[{command.upper()}]'
            if command == 'href':
                label, position = group(position)
                label = render_tex(label)
            result.append(f'<a href="{html.escape(url, quote=True)}">{label}</a>')
    return ''.join(result)


def publication_fields(citation):
    """Retain supported inline markup and every bibliographic field."""
    match = re.fullmatch(r'(.*?)“(.*?)”\s*(.*)', citation)
    if not match:
        return {'citation': citation}
    authors, title, details = match.groups()
    links = []
    labels = {'[DOI]': 'Read article', '[SSRN]': 'SSRN', '[PDF]': 'PDF'}
    for url, label in re.findall(r'<a href="([^"]+)">(.*?)</a>', details):
        links.append({'url': html.unescape(url), 'label': labels.get(label, label)})
    details = re.sub(r'<a href="[^"]+">.*?</a>', '', details)
    details = re.sub(r'\s+\.', '.', details).strip()
    details = re.sub(r'\.{2,}$', '.', details)
    return {'title': title.rstrip('.'), 'authors': authors.strip(),
            'details': details, 'links': links}


def publications(source):
    source = re.sub(r'(?m)(?<!\\)%.*$', '', source)
    section = re.search(r'\\section\{PUBLICATIONS\}(.*?)(?=\\section\{|\\end\{document\})', source, re.S)
    if not section:
        raise ValueError('CV is missing its PUBLICATIONS section')
    pattern = re.compile(
        r'\s*\\subsection\*?\{([^{}]+)\}\s*'
        r'\\begin\{(publicationlist|manuscriptlist)\}(.*?)\\end\{\2\}', re.S)
    body = section[1]
    output = []
    position = 0
    other_publications = []
    for match in pattern.finditer(body):
        if body[position:match.start()].strip():
            raise ValueError('Unsupported content in CV publications section')
        title, environment, entries = match.groups()
        headings = {'Refereed Journal Articles': 'Peer Reviewed Articles',
                    'Invited Articles': 'Other Publications',
                    'Working Papers and Manuscripts': 'Working papers'}
        heading = headings.get(title, title)
        anchor = re.sub(r'[^a-z0-9 -]', '', title.lower()).replace(' ', '-')
        numbered = environment == 'publicationlist'
        section_data = {'heading': heading, 'anchor': anchor,
                        'numbered': numbered, 'items': []}
        items = list(re.finditer(r'\\item\s*(?:\[(\d+)\.\])?\s*(.*?)(?=\\item|\Z)', entries, re.S))
        if not items or entries[:items[0].start()].strip():
            raise ValueError(f'Missing or malformed entries in {title}')
        for item in items:
            number, citation = item.groups()
            if numbered != bool(number):
                raise ValueError(f'Unexpected publication numbering in {title}')
            citation = render_tex(re.sub(r'\s+', ' ', citation).strip())
            fields = publication_fields(citation)
            if number:
                fields['number'] = int(number)
            section_data['items'].append(fields)
        if title == 'Invited Articles':
            other_publications.append(section_data)
        else:
            output.append(section_data)
        position = match.end()
    if not position or body[position:].strip():
        raise ValueError('Unsupported content in CV publications section')
    return output + other_publications


def sync(check=False):
    destination = ROOT / '_data/publications.json'
    updated = json.dumps(publications((ROOT / 'CV/CV.tex').read_text()),
                         ensure_ascii=False, indent=2) + '\n'
    original = destination.read_text() if destination.exists() else None
    if check:
        if updated != original:
            raise ValueError('Publication data differs from CV. Run script/sync-publications.')
    elif updated != original:
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(updated)
        print('Updated publication data from CV/CV.tex.')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='Fail if publication data differs from the CV')
    try:
        sync(parser.parse_args().check)
    except ValueError as error:
        parser.exit(1, f'{error}\n')
